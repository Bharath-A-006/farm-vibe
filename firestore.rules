rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || role() == 'admin');
      // public tourist self-signup only; farmer/guide/admin via backend
      allow create: if request.resource.data.role == 'tourist';
      allow update: if signedIn() && (request.auth.uid == id || role() == 'admin');
      allow delete: if false;
    }
    match /farms/{id} {
      allow read: if true;
      allow create: if signedIn() && (role() == 'farmer' || role() == 'admin');
      allow update: if signedIn() && (role() == 'admin' || resource.data.farmerId == request.auth.uid);
      allow delete: if signedIn() && role() == 'admin';
    }
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.touristId == request.auth.uid || role() in ['admin', 'farmer', 'guide']);
      allow create: if signedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if signedIn() && role() == 'admin';
      allow delete: if false;
    }
    match /complaints/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || role() == 'admin');
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && role() == 'admin';
      allow delete: if false;
    }
    match /{rest=**} {
      allow read, write: if signedIn() && role() == 'admin';
    }
  }
}
